{
  "openapi": "3.0.3",
  "info": {
    "title": "My Example API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.retrodiffusion.ai/v1",
      "description": "Production"
    }
  ],
  "paths": {
    "/styles/selector": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        },
        {
          "$ref": "#/components/parameters/model"
        },
        {
          "$ref": "#/components/parameters/tab"
        }
      ],
      "get": {
        "summary": "Live style catalog with limits",
        "operationId": "ListAvailableStyles",
        "responses": {
          "200": {
            "$ref": "#/components/responses/StyleDescriptors"
          }
        }
      }
    },
    "/styles/{style_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        },
        {
          "$ref": "#/components/parameters/style_id"
        }
      ],
      "delete": {
        "summary": "Delete user style",
        "operationId": "DeleteUserStyle",
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeleteUserStyleOkResponse"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeleteUserStyleOkJSONResponse": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorWithCode"
          }
        },
        "required": [
          "detail"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string"
          }
        }
      },
      "ErrorDetails": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ErrorDetail"
        }
      },
      "ErrorWithCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "inference_failed"
          },
          "message": {
            "type": "string",
            "example": "Unable to run inference."
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "example": "070ef31d-b384-426e-b4e8-3773d9ad1c94"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "ErrorWithLocation": {
        "type": "object",
        "properties": {
          "loc": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "body"
            }
          },
          "msg": {
            "type": "string",
            "example": "field required"
          },
          "type": {
            "type": "string",
            "example": "value_error.missing"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ]
      },
      "Errors": {
        "type": "object",
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        }
      },
      "Inference": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "date-time",
            "example": 1788096424
          },
          "balance_cost": {
            "type": "number",
            "format": "double",
            "example": 0.18
          },
          "base64_images": {
            "description": "Raw base64 PNG (or GIF for animations)",
            "type": "array",
            "items": {
              "type": "string",
              "example": ""
            }
          },
          "output_urls": {
            "description": "15-minute signed URLs when upload_outputs=true",
            "type": "array",
            "items": {
              "type": "string",
              "example": null
            }
          },
          "model": {
            "type": "string",
            "example": "check_cost"
          },
          "remaining_balance": {
            "type": "number",
            "format": "double",
            "example": 0.5
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "example": "38cc4f48-cbcd-4420-ae51-3c3ec21e5b41"
          },
          "outputs_retained_until": {
            "type": "integer",
            "format": "date-time",
            "example": 1788302691
          },
          "credit_cost": {
            "type": "integer",
            "example": 0
          },
          "output_images": {
            "type": "array",
            "items": {
              "type": "object",
              "example": null
            }
          },
          "remaining_credits": {
            "type": "integer",
            "example": 0
          }
        },
        "required": [
          "created_at",
          "balance_cost",
          "base64_images",
          "model",
          "remaining_balance",
          "request_id",
          "outputs_retained_until"
        ]
      },
      "InferenceRequest": {
        "type": "object",
        "properties": {
          "prompt": {
            "description": "Describe the SUBJECT only. Never write 'pixel art'.",
            "type": "string",
            "example": "security officer (a soldier). A 34-year-old male human. Lean and wiry, with a posture that suggests he's always expecting something to break. He wears the standard grey-blue security fatigues, kept meticulously clean despite the dust of the colony. A thin, jagged scar running through his left eyebrow. He has a habit of clicking his tongue when he's impatient."
          },
          "prompt_style": {
            "$ref": "#/components/schemas/PromptStyle"
          },
          "width": {
            "description": "Style-enforced tighter limits apply (most top out at 384)",
            "type": "integer",
            "minimum": 16,
            "maximum": 512,
            "example": 128
          },
          "height": {
            "type": "integer",
            "minimum": 16,
            "maximum": 512,
            "example": 128
          },
          "num_images": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "seed": {
            "description": "Reproducible generation",
            "type": "integer"
          },
          "input_image": {
            "description": "Raw base64 PNG (no data: URI prefix), RGB no transparency. Required for img2img, advanced animation, some edit tools.",
            "type": "string"
          },
          "strength": {
            "description": "How much to change input_image",
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.75
          },
          "reference_images": {
            "description": "Base64 images. RD Pro styles only. Guides style/content.",
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "string"
            }
          },
          "input_palette": {
            "description": "Base64 palette constraining output colors",
            "type": "string"
          },
          "remove_bg": {
            "description": "Transparent output",
            "type": "boolean"
          },
          "tile_x": {
            "type": "boolean"
          },
          "tile_y": {
            "type": "boolean"
          },
          "frames_duration": {
            "description": "Animation styles only",
            "type": "integer",
            "enum": [
              4,
              6,
              8,
              10,
              12,
              16
            ]
          },
          "return_spritesheet": {
            "description": "Animations: PNG spritesheet instead of GIF",
            "type": "boolean"
          },
          "upscale_output_factor": {
            "description": "1 = native pixel size",
            "type": "integer",
            "example": 1
          },
          "bypass_prompt_expansion": {
            "description": "Skip automatic LLM prompt enrichment",
            "type": "boolean"
          },
          "include_downloadable_data": {
            "description": "Extra structured assets e.g. item atlas JSON",
            "type": "boolean"
          },
          "check_cost": {
            "description": "FREE dry run: returns price, generates nothing, charges nothing",
            "type": "boolean"
          },
          "async": {
            "description": "Return task_id for polling instead of waiting",
            "type": "boolean"
          },
          "upload_outputs": {
            "description": "Receive temporary signed URLs in output_urls instead of (or with) base64",
            "type": "boolean"
          },
          "extra_prompt": {
            "description": "For advanced tileset styles",
            "type": "string"
          },
          "extra_input_image": {
            "description": "For advanced tileset styles",
            "type": "string"
          },
          "negative": {
            "description": "Placeholder — current models ignore it. Do not rely on it.",
            "type": "string"
          }
        },
        "required": [
          "prompt",
          "prompt_style",
          "width",
          "height",
          "num_images"
        ]
      },
      "InferenceRequestResult": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "ListEditToolsOkJSONResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "Model": {
        "type": "string",
        "enum": [
          "rd_fast",
          "rd_plus",
          "rd_pro",
          "rd_mini"
        ],
        "example": "rd_pro"
      },
      "Models": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Model"
        }
      },
      "PixelFixerRequest": {
        "description": "Provide exactly one of input_image or image_url. width/height are optional and only used by the neural endpoint.",
        "type": "object",
        "properties": {
          "input_image": {
            "description": "Raw base64 PNG/JPEG/WebP or data URI",
            "type": "string"
          },
          "image_url": {
            "description": "Public HTTPS PNG/JPEG/WebP",
            "type": "string",
            "format": "uri"
          },
          "width": {
            "description": "Neural only: target output width",
            "type": "integer"
          },
          "height": {
            "description": "Neural only: target output height",
            "type": "integer"
          }
        }
      },
      "PixelFixerResponse": {
        "type": "object",
        "properties": {
          "base64_images": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PromptStyle": {
        "description": "Style id e.g. rd_fast__default, rd_pro__default, rd_plus__default, animation/tile variants, or user__name_id",
        "type": "string",
        "enum": [
          "rd_animation__8_dir_rotation",
          "rd_animation__any_animation",
          "rd_animation__big_animation",
          "rd_advanced_animation__custom_action",
          "rd_pro__default",
          "rd_pro__default_copy_1784901263973",
          "rd_tile__tileset",
          "rd_animation__large_walking_idle",
          "rd_pro__painterly",
          "rd_tile__tileset_advanced",
          "rd_advanced_animation__walking",
          "rd_advanced_animation__idle",
          "rd_pro__simple",
          "rd_tile__single_tile",
          "rd_animation__four_angle_walking_idle",
          "rd_pro__fantasy",
          "rd_animation__four_angle_walking",
          "rd_advanced_animation__jump",
          "rd_tile__tile_variation",
          "rd_animation__battle_sprites",
          "rd_advanced_animation__crouch",
          "rd_pro__horror",
          "rd_animation__small_sprites",
          "rd_tile__tile_object",
          "rd_advanced_animation__attack",
          "rd_tile__scene_object",
          "rd_pro__scifi",
          "rd_animation__vfx",
          "rd_advanced_animation__destroy",
          "rd_pro__isometric",
          "rd_advanced_animation__subtle_motion",
          "rd_pro__topdown",
          "rd_pro__platformer",
          "rd_pro__dungeon_map",
          "rd_pro__spritesheet",
          "rd_pro__hexagonal_tiles",
          "rd_pro__fps_weapon",
          "rd_pro__typography",
          "rd_pro__ui_panel",
          "rd_pro__inventory_items",
          "rd_animation__dinoki",
          "animation:rd_animated256_4by4_v3_000013000",
          "rd_pro__pixelate",
          "rd_pro__edit",
          "rd_pro__default_copy_1782957236125",
          "rd_pro__default_copy_1782957236125_copy_1786939279986",
          "rd_pro__default_copy_1782957236125_copy_1786939279986_copy_1786990902501",
          "rd_plus__default",
          "default:rd_flux",
          "simple:rd_flux",
          "detailed:rd_flux",
          "rd_plus__retro",
          "retro:rd_flux",
          "rd_plus__watercolor",
          "game_asset:rd_flux",
          "portrait:rd_flux",
          "rd_plus__textured",
          "rd_plus__cartoon",
          "texture:rd_flux",
          "rd_plus__ui_element",
          "ui_element:rd_flux",
          "item_sheet",
          "rd_plus__item_sheet",
          "character_turnaround:rd_flux",
          "rd_plus__character_turnaround",
          "rd_fast__1_bit",
          "rd_plus__environment",
          "rd_mini__fast_low_res",
          "rd_fast__low_res",
          "rd_mini__fast_mc_item",
          "rd_plus__isometric",
          "rd_fast__mc_item",
          "rd_mini__fast_mc_texture",
          "rd_plus__isometric_asset",
          "rd_fast__mc_texture",
          "rd_mini__classic",
          "rd_mini__topdown_item",
          "rd_plus__topdown_map",
          "rd_mini__low_res",
          "rd_plus__topdown_asset",
          "rd_mini__skill_icon",
          "rd_plus__topdown_item",
          "rd_plus__classic",
          "rd_mini__mc_item",
          "rd_mini__mc_texture",
          "rd_plus__skill_icon",
          "rd_plus__low_res",
          "rd_plus__mc_item",
          "rd_plus__mc_texture",
          "craftverse__t7",
          "rd_plus__no_style",
          "no_style:rd_flux"
        ],
        "example": "rd_animation__8_dir_rotation"
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "updated_at": {
            "type": "integer"
          }
        }
      },
      "Style": {
        "type": "object",
        "properties": {
          "prompt_style": {
            "$ref": "#/components/schemas/PromptStyle"
          },
          "name": {
            "type": "string",
            "example": "8 Direction Rotation"
          },
          "description": {
            "type": "string",
            "example": "Create 8 direction rotations of anything."
          },
          "required_model": {
            "$ref": "#/components/schemas/Model"
          },
          "required_tab": {
            "$ref": "#/components/schemas/Tab"
          },
          "min_width": {
            "type": "integer",
            "example": 80
          },
          "max_width": {
            "type": "integer",
            "example": 80
          },
          "min_height": {
            "type": "integer",
            "example": 80
          },
          "max_height": {
            "type": "integer",
            "example": 80
          },
          "max_number_of_images": {
            "type": "integer",
            "example": 1
          },
          "require_input_image": {
            "type": "boolean",
            "example": null
          },
          "supports_reference_images": {
            "type": "boolean"
          },
          "example_prompt": {
            "type": "string",
            "example": "An orange cat playing with a blue ball of yarn"
          },
          "group_id": {
            "type": "string",
            "example": "RD Animation"
          }
        }
      },
      "StyleDescriptors": {
        "type": "object",
        "properties": {
          "styles": {
            "$ref": "#/components/schemas/Styles"
          },
          "models": {
            "$ref": "#/components/schemas/Models"
          },
          "tabs": {
            "$ref": "#/components/schemas/Tabs"
          }
        }
      },
      "Styles": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Style"
        }
      },
      "Tab": {
        "type": "string",
        "enum": [
          "tab:image",
          "tab:animation",
          "tab:advanced-animation",
          "tab:tileset"
        ],
        "example": "tab:advanced-animation"
      },
      "Tabs": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Tab"
        }
      },
      "TaskStatus": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/TaskStatusStatus"
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "result": {
            "$ref": "#/components/schemas/Inference"
          },
          "error": {
            "$ref": "#/components/schemas/TaskStatusError"
          }
        },
        "required": [
          "status",
          "task_id"
        ]
      },
      "TaskStatusError": {
        "type": "object",
        "properties": {
          "status_code": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "TaskStatusStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed"
        ]
      },
      "ToolID": {
        "type": "string",
        "enum": [
          "image_edit",
          "inpainting",
          "outpainting",
          "seam_tiling",
          "background_remover",
          "color_style_transfer",
          "color_reducer",
          "palette_converter",
          "k_centroid_downscale",
          "pixel_correction",
          "rotate"
        ]
      }
    },
    "responses": {
      "DeleteUserStyleOkResponse": {
        "description": "Deleted",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DeleteUserStyleOkJSONResponse"
            }
          }
        }
      },
      "Style": {
        "description": "Style created",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Style"
            }
          }
        }
      },
      "StyleDescriptors": {
        "description": "Array of style descriptors",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StyleDescriptors"
            }
          }
        }
      }
    },
    "parameters": {
      "X-Rd-Token": {
        "name": "X-Rd-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "model": {
        "name": "model",
        "in": "query",
        "schema": {
          "type": "string",
          "example": "rd_pro",
          "$ref": "#/components/schemas/Model"
        }
      },
      "request_id": {
        "name": "request_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "style_id": {
        "name": "style_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/PromptStyle"
        }
      },
      "tab": {
        "name": "tab",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/Tab"
        }
      }
    },
    "securitySchemes": {
      "XRdToken": {
        "type": "apiKey",
        "description": "API key starting with rdpk-. Create at https://www.retrodiffusion.ai/app/devtools (max 5 per account).",
        "name": "X-RD-Token",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "XRdToken": []
    }
  ]
}