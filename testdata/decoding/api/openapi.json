      "NumberValue": {
        "type": "object",
        "required": [
          "type",
          "number"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "number"
          },
          "number": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "GroupBy": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "type",
              "property"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "select"
              },
              "property": {
                "type": "string"
              },
              "sort": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "property"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "date"
              },
              "property": {
                "type": "string"
              },
              "sort": {
                "type": "string"
              },
              "period": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Bot": {
        "anyOf": [
          {
            "type": "object",
            "properties": {}
          },
          {
            "type": "object",
            "required": [
