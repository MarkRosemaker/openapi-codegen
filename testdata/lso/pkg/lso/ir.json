{
	"title": "LSO Trader API",
	"production": true,
	"packageName": "lso",
	"baseURL": {
		"scheme": "http",
		"host": "localhost:8081",
		"path": "/api"
	},
	"userAgent": "LSO Trader API",
	"operations": [
		{
			"name": "ListAccounts",
			"summary": "List all brokerage accounts",
			"method": "GET",
			"pathTemplate": "/accounts",
			"joinPathArgs": [
				"\"accounts\""
			],
			"responses": [
				{
					"statusCode": "200",
					"goConstant": "http.StatusOK",
					"description": "List of accounts sorted by creation date",
					"contentType": "application/json",
					"goType": {
						"name": "ListAccountsResult"
					},
					"isSuccess": true
				},
				{
					"statusCode": "502",
					"goConstant": "http.StatusBadGateway",
					"description": "IBKR gateway is not running or not authenticated",
					"contentType": "application/json",
					"goType": {
						"name": "Error"
					}
				}
			],
			"successReturn": {
				"name": "ListAccountsResult"
			}
		},
		{
			"name": "GetPositions",
			"summary": "Get all holdings for an account",
			"method": "GET",
			"pathTemplate": "/accounts/{account_id}/positions",
			"joinPathArgs": [
				"\"accounts\"",
				"accountID",
				"\"positions\""
			],
			"pathParams": [
				{
					"varName": "accountID",
					"goName": "accountID",
					"fieldName": "AccountID",
					"jsonName": "account_id",
					"type": "string",
					"required": true,
					"parseExpr": "s",
					"parseErrFree": true,
					"description": "IBKR account identifier (e.g. U1234567)"
				}
			],
			"hasParams": true,
			"responses": [
				{
					"statusCode": "200",
					"goConstant": "http.StatusOK",
					"description": "Stock and option positions",
					"contentType": "application/json",
					"goType": {
						"name": "Positions"
					},
					"isSuccess": true
				},
				{
					"statusCode": "502",
					"goConstant": "http.StatusBadGateway",
					"description": "IBKR gateway is not running or not authenticated",
					"contentType": "application/json",
					"goType": {
						"name": "Error"
					}
				}
			],
			"successReturn": {
				"name": "Positions"
			}
		},
		{
			"name": "GetCash",
