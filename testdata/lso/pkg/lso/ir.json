			"pathTemplate": "/accounts/{account_id}/summary",
			"joinPathArgs": [
				"\"accounts\"",
				"accountID",
				"\"summary\""
			],
			"pathParams": [
				{
					"varName": "accountID",
					"goName": "accountID",
					"fieldName": "AccountID",
					"jsonName": "account_id",
					"type": "string",
					"required": true,
					"parseExpr": "s",
					"parseErrFree": true,
					"description": "IBKR account identifier (e.g. U1234567)"
				}
			],
			"hasParams": true,
			"responses": [
				{
					"statusCode": "200",
					"goConstant": "http.StatusOK",
