					"required": true,
					"parseExpr": "s",
					"parseErrFree": true,
					"description": "IBKR account identifier (e.g. U1234567)"
				}
			],
			"hasParams": true,
			"responses": [
				{
					"statusCode": "200",
					"goConstant": "http.StatusOK",
					"description": "Cash balances by currency",
					"contentType": "application/json",
