					"goType": {
						"name": "Error"
					}
				}
			],
			"successReturn": {
				"name": "AccountSummary"
			}
		},
		{
			"name": "GetFundamentals",
			"description": "Returns company info, income statement highlights, balance sheet highlights, and time-series data for charting.",
			"summary": "Get fundamentals analysis for a company",
			"method": "GET",
			"pathTemplate": "/fundamentals/{cik}",
			"joinPathArgs": [
				"\"fundamentals\"",
				"strconv.Itoa(cik)"
			],
			"pathParams": [
				{
					"varName": "cik",
					"goName": "cik",
					"fieldName": "Cik",
					"jsonName": "cik",
					"type": "int",
					"required": true,
					"parseExpr": "strconv.Atoi(s)",
					"description": "SEC Central Index Key"
				}
			],
			"hasParams": true,
			"responses": [
				{
					"statusCode": "200",
					"goConstant": "http.StatusOK",
					"description": "Full fundamentals analysis",
					"contentType": "application/json",
					"goType": {
						"name": "FundamentalsAnalysis"
					},
					"isSuccess": true
				},
				{
					"statusCode": "404",
					"goConstant": "http.StatusNotFound",
					"description": "Symbol not found in SEC EDGAR or stockdata service",
					"contentType": "application/json",
					"goType": {
						"name": "Error"
					}
				}
			],
			"successReturn": {
				"name": "FundamentalsAnalysis"
			}
		},
