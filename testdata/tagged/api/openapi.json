{
  "openapi": "3.1.0",
  "info": {"title": "Tagged", "version": "1"},
  "servers": [{"url": "https://api.example.com"}],
  "paths": {
    "/values/{id}": {"get": {"operationId": "getValue", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {
      "200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Value"}}}}
    }}},
    "/blocks/{id}": {"get": {"operationId": "getBlock", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {
      "200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Block"}}}}
    }}}
  },
  "components": {"schemas": {
    "Block": {"oneOf": [{"$ref": "#/components/schemas/Paragraph"}, {"$ref": "#/components/schemas/ChildDatabase"}, {"$ref": "#/components/schemas/Relation"}]},
    "Paragraph": {"type": "object", "required": ["id", "type", "paragraph"], "properties": {
      "id": {"type": "string"}, "type": {"type": "string", "const": "paragraph"}, "paragraph": {"type": "string"}}},
    "ChildDatabase": {"type": "object", "required": ["id", "type", "child_database"], "properties": {
      "id": {"type": "string"}, "type": {"type": "string", "const": "child_database"}, "child_database": {"type": "string"}}},
    "Relation": {"type": "object", "required": ["id", "type", "relation"], "properties": {
      "id": {"type": "string"}, "type": {"type": "string", "const": "relation"},
      "relation": {"type": "array", "items": {"type": "string"}}, "has_more": {"type": "boolean"}}},

    "Value": {"allOf": [{"$ref": "#/components/schemas/Common"}, {"oneOf": [{"$ref": "#/components/schemas/SimpleOrArray"}, {"$ref": "#/components/schemas/Rollup"}]}]},
    "Common": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}},
    "SimpleOrArray": {"oneOf": [{"$ref": "#/components/schemas/Simple"}, {"$ref": "#/components/schemas/Array"}]},
    "Simple": {"oneOf": [{"$ref": "#/components/schemas/Number"}, {"$ref": "#/components/schemas/Text"}]},
    "Array": {"oneOf": [{"$ref": "#/components/schemas/Relation2"}]},
    "Number": {"type": "object", "required": ["type", "number"], "properties": {"type": {"const": "number", "type": "string"}, "number": {"type": "number"}}},
    "Text": {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "text", "type": "string"}, "text": {"type": "string"}}},
    "Relation2": {"type": "object", "required": ["type", "relation"], "properties": {"type": {"const": "relation", "type": "string"}, "relation": {"type": "array", "items": {"type": "string"}}, "has_more": {"type": "boolean"}}},
    "Rollup": {"type": "object", "required": ["type", "function"], "properties": {"type": {"const": "rollup", "type": "string"}, "function": {"type": "string"}}}
  }}
}
