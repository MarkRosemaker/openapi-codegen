    "/reports": {
      "get": {
        "operationId": "listReports",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": true
          },
          {
            "name": "ids",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "verbose",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "An enum.",
            "schema": {
              "$ref": "#/components/schemas/ScheduleFormat"
            }
          },
          {
            "name": "formats",
            "in": "query",
            "description": "A list of an enum.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ScheduleFormat"
              }
            }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "A union of an array and its items is sent as the array.",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "A query string cannot carry null, so the string is all that is left.",
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "A union of strings is a string.",
            "schema": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "asc"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "desc"
                  ]
                }
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "A union of anything else is sent as it is.",
            "schema": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          {
            "name": "pairs",
            "in": "query",
            "description": "So is a union of two arrays.",
            "schema": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              ]
            }
          },
          {
            "name": "X-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Required, so an argument of every call."
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reports"
                }
              }
            }
          }
        }
      }
    },
    "/people": {
      "get": {
